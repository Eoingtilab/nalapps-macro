<Application x:Class="NalApps.Macro.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#3182F6" />
        <SolidColorBrush x:Key="BackgroundBrush" Color="#F4F7FB" />
        <SolidColorBrush x:Key="TextBrush" Color="#191F28" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8B95A1" />
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Pretendard, Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,11" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Pretendard, Segoe UI" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
    </Application.Resources>
</Application>
