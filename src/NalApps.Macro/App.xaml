<Application x:Class="NalApps.Macro.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:NalApps.Macro.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/NalaApps.DesignSystem.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:MillisecondsToSecondsConverter x:Key="MillisecondsToSecondsConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
