<Window x:Class="NalApps.Macro.DelayDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="대기 시간 추가"
        Width="380" Height="310"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="16">
        <Border Style="{StaticResource NalaCard}" Padding="22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="대기 시간" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="1초 단위로 조절하거나 원하는 시간을 직접 입력합니다."
                               Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="−" Height="42" Click="Decrease_Click" />
                    <TextBox Grid.Column="1" x:Name="SecondsBox" Text="1" Height="42"
                             Margin="9,0" Padding="10,7" FontSize="15" TextAlignment="Center" />
                    <Button Grid.Column="2" Content="＋" Height="42" Click="Increase_Click" />
                </Grid>

                <WrapPanel Grid.Row="4" HorizontalAlignment="Center">
                    <Button Content="1초" Padding="10,6" Tag="1" Click="Preset_Click" />
                    <Button Content="5초" Padding="10,6" Tag="5" Click="Preset_Click" />
                    <Button Content="10초" Padding="10,6" Tag="10" Click="Preset_Click" />
                    <Button Content="30초" Padding="10,6" Tag="30" Click="Preset_Click" />
                    <Button Content="50초" Padding="10,6" Tag="50" Click="Preset_Click" />
                    <Button Content="60초" Padding="10,6" Tag="60" Click="Preset_Click" />
                </WrapPanel>

                <Grid Grid.Row="6" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="취소" Height="40" IsCancel="True" />
                    <Button Grid.Column="2" Content="시간 추가" Height="40"
                            Style="{StaticResource PrimaryButtonStyle}" Click="Add_Click" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
