<Window x:Class="NalApps.Macro.KeyActionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="키보드 동작"
        Width="430" Height="500"
        MinWidth="400" MinHeight="430"
        MaxHeight="650"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="16">
        <Border Style="{StaticResource NalaCard}" Padding="22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="키보드 동작" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="한 번 누르기, 조합키, 길게 누르기를 설정합니다."
                                   Margin="0,5,0,16" FontSize="11" Foreground="{StaticResource MutedBrush}" />

                        <TextBlock Text="빠른 선택" Margin="0,0,0,6" FontSize="11" FontWeight="SemiBold" />
                        <ComboBox x:Name="PresetBox" Height="36" SelectionChanged="PresetBox_SelectionChanged">
                            <ComboBoxItem Content="Enter" Tag="ENTER" IsSelected="True" />
                            <ComboBoxItem Content="Space" Tag="SPACE" />
                            <ComboBoxItem Content="Tab" Tag="TAB" />
                            <ComboBoxItem Content="Esc" Tag="ESC" />
                            <ComboBoxItem Content="Ctrl + C" Tag="CTRL+C" />
                            <ComboBoxItem Content="Ctrl + V" Tag="CTRL+V" />
                            <ComboBoxItem Content="Ctrl + A" Tag="CTRL+A" />
                            <ComboBoxItem Content="Ctrl + S" Tag="CTRL+S" />
                            <ComboBoxItem Content="Ctrl + Shift + S" Tag="CTRL+SHIFT+S" />
                            <ComboBoxItem Content="Alt + Tab" Tag="ALT+TAB" />
                            <ComboBoxItem Content="Win + D" Tag="WIN+D" />
                            <ComboBoxItem Content="Print Screen" Tag="PRINTSCREEN" />
                            <ComboBoxItem Content="F5" Tag="F5" />
                            <ComboBoxItem Content="직접 입력" Tag="" />
                        </ComboBox>

                        <TextBlock Text="키 또는 조합키" Margin="0,15,0,6" FontSize="11" FontWeight="SemiBold" />
                        <TextBox x:Name="KeyExpressionBox" Text="ENTER" Height="36" Padding="10,6" />
                        <TextBlock Text="A~Z, 0~9, F1~F24 및 CTRL+C, CTRL+SHIFT+S, ALT+TAB 지원"
                                   Margin="0,5,0,0" FontSize="9.5" Foreground="{StaticResource MutedBrush}" />

                        <TextBlock Text="동작 방식" Margin="0,15,0,7" FontSize="11" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="PressOnceRadio" Content="한 번 누르기" IsChecked="True"
                                         GroupName="KeyMode" Margin="0,0,20,0" Checked="Mode_Changed" />
                            <RadioButton x:Name="HoldRadio" Content="누르고 있기"
                                         GroupName="KeyMode" Checked="Mode_Changed" />
                        </StackPanel>

                        <StackPanel x:Name="HoldPanel" IsEnabled="False" Margin="0,15,0,0">
                            <TextBlock Text="누르고 있을 시간(초)" Margin="0,0,0,6" FontSize="11" FontWeight="SemiBold" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="−" Height="36" Click="Decrease_Click" />
                                <TextBox Grid.Column="1" x:Name="HoldSecondsBox" Text="10" Height="36"
                                         Margin="8,0" Padding="10,6" TextAlignment="Center" />
                                <Button Grid.Column="2" Content="＋" Height="36" Click="Increase_Click" />
                            </Grid>
                            <TextBlock Text="1초 단위로 조절하거나 직접 입력할 수 있습니다."
                                       Margin="0,5,0,4" FontSize="9.5" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="취소" Height="42" IsCancel="True" />
                    <Button Grid.Column="2" Content="동작 적용" Height="42"
                            Style="{StaticResource PrimaryButtonStyle}" Click="Add_Click" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
