<Window x:Class="NalApps.Macro.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="문자 입력"
        Width="500" Height="470"
        MinWidth="470" MinHeight="440"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="16">
        <Border Style="{StaticResource NalaCard}" Padding="22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="문자 입력" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="아래 입력칸을 클릭하고 키보드로 원하는 문장을 직접 입력하세요."
                               Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>

                <TextBox Grid.Row="2" x:Name="TextValueBox"
                         AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Padding="12" FontSize="13" VerticalContentAlignment="Top"
                         SpellCheck.IsEnabled="False" />

                <StackPanel Grid.Row="4">
                    <TextBlock Text="글자 사이 입력 간격(밀리초)" Margin="0,0,0,6" FontSize="11" FontWeight="SemiBold" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="−" Height="36" Click="DecreaseInterval_Click" />
                        <TextBox Grid.Column="1" x:Name="IntervalBox" Text="20" Height="36"
                                 Margin="8,0" Padding="9,6" TextAlignment="Center" />
                        <Button Grid.Column="2" Content="＋" Height="36" Click="IncreaseInterval_Click" />
                    </Grid>
                    <WrapPanel Margin="0,7,0,0" HorizontalAlignment="Center">
                        <Button Content="즉시" Padding="9,5" Tag="0" Click="IntervalPreset_Click" />
                        <Button Content="20ms" Padding="9,5" Tag="20" Click="IntervalPreset_Click" />
                        <Button Content="50ms" Padding="9,5" Tag="50" Click="IntervalPreset_Click" />
                        <Button Content="100ms" Padding="9,5" Tag="100" Click="IntervalPreset_Click" />
                    </WrapPanel>
                    <TextBlock Text="줄바꿈은 Enter, 탭은 Tab 키 동작으로 실행됩니다."
                               Margin="0,6,0,0" FontSize="9.5" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>

                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="취소" Height="42" IsCancel="True" />
                    <Button Grid.Column="2" Content="문자 동작 적용" Height="42"
                            Style="{StaticResource PrimaryButtonStyle}" Click="Apply_Click" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
