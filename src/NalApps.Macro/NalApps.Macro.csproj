<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>NalaApps.Macro</AssemblyName>
    <RootNamespace>NalApps.Macro</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Version>1.1.1</Version>
    <AssemblyVersion>1.1.1.0</AssemblyVersion>
    <FileVersion>1.1.1.0</FileVersion>
    <InformationalVersion>1.1.1</InformationalVersion>
    <Product>NalaApps Macro</Product>
    <Company>Eoingti Lab</Company>
    <Authors>Eoingti Lab</Authors>
    <Description>무료·무인증 Windows 데스크톱 키보드 및 마우스 매크로 도구</Description>
    <Copyright>Copyright © 2026 Eoingti Lab</Copyright>
    <RepositoryUrl>https://github.com/Eoingtilab/nalapps-macro</RepositoryUrl>
    <DebugType>embedded</DebugType>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
