<Window x:Class="NalApps.Macro.PositionPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="#550B1525"
        Topmost="True" ShowInTaskbar="False" Cursor="Cross"
        WindowStartupLocation="Manual" KeyDown="Window_KeyDown"
        MouseMove="Window_MouseMove" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Canvas x:Name="RootCanvas">
        <Border x:Name="Guide" Background="#F5FFFFFF" CornerRadius="18" Padding="20,14"
                Canvas.Left="24" Canvas.Top="24">
            <StackPanel>
                <TextBlock Text="원하는 위치를 클릭하세요" FontSize="19" FontWeight="Bold" />
                <TextBlock x:Name="CoordinateText" Text="X 0 / Y 0" Margin="0,5,0,0" Foreground="#3182F6" FontSize="15" />
                <TextBlock Text="클릭은 대상 프로그램에 전달되지 않습니다 · Esc 취소" Margin="0,5,0,0" Foreground="#6B7684" />
            </StackPanel>
        </Border>
        <Line x:Name="VerticalLine" Stroke="#FF3182F6" StrokeThickness="1" IsHitTestVisible="False" />
        <Line x:Name="HorizontalLine" Stroke="#FF3182F6" StrokeThickness="1" IsHitTestVisible="False" />
        <Ellipse x:Name="TargetCircle" Width="30" Height="30" Stroke="White" StrokeThickness="2"
                 Fill="#553182F6" IsHitTestVisible="False" />
    </Canvas>
</Window>
