<Window x:Class="NalApps.Macro.MouseActionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="마우스 동작"
        Width="470" Height="610"
        MinWidth="450" MinHeight="590"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="16">
        <Border Style="{StaticResource NalaCard}" Padding="22">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="마우스 동작" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="위치, 클릭 종류, 반복 횟수와 연속 실행 시간을 설정합니다."
                               Margin="0,5,0,16" FontSize="11" Foreground="{StaticResource MutedBrush}" />

                    <TextBlock Text="동작 종류" Margin="0,0,0,6" FontSize="11" FontWeight="SemiBold" />
                    <ComboBox x:Name="ActionBox" Height="38" SelectionChanged="ActionBox_SelectionChanged">
                        <ComboBoxItem Content="마우스 이동" Tag="move" />
                        <ComboBoxItem Content="왼쪽 클릭" Tag="left" IsSelected="True" />
                        <ComboBoxItem Content="오른쪽 클릭" Tag="right" />
                        <ComboBoxItem Content="더블 클릭" Tag="double" />
                        <ComboBoxItem Content="휠 위" Tag="wheelup" />
                        <ComboBoxItem Content="휠 아래" Tag="wheeldown" />
                    </ComboBox>

                    <Separator Margin="0,16" />

                    <CheckBox x:Name="FixedPositionCheck" Content="실행 전에 지정 위치로 이동"
                              FontWeight="SemiBold" Checked="PositionMode_Changed" Unchecked="PositionMode_Changed" />
                    <Grid x:Name="PositionPanel" Margin="0,10,0,0" IsEnabled="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="X 좌표" Margin="0,0,0,5" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                            <TextBox x:Name="XBox" Height="36" Padding="9,6" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Y 좌표" Margin="0,0,0,5" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                            <TextBox x:Name="YBox" Height="36" Padding="9,6" />
                        </StackPanel>
                        <Button Grid.Row="2" Grid.ColumnSpan="3" Content="화면에서 위치 선택"
                                Height="38" Style="{StaticResource PrimaryButtonStyle}" Click="PickPosition_Click" />
                    </Grid>
                    <TextBlock Text="체크하지 않으면 실행 순간의 현재 마우스 위치에서 동작합니다."
                               Margin="0,7,0,0" FontSize="9.5" Foreground="{StaticResource MutedBrush}" />

                    <Separator Margin="0,16" />

                    <StackPanel x:Name="RepeatPanel">
                        <TextBlock Text="실행 방식" Margin="0,0,0,8" FontSize="11" FontWeight="SemiBold" />
                        <WrapPanel>
                            <RadioButton x:Name="OnceRadio" Content="한 번" IsChecked="True" GroupName="RepeatMode"
                                         Margin="0,0,18,0" Checked="RepeatMode_Changed" />
                            <RadioButton x:Name="CountRadio" Content="횟수 지정" GroupName="RepeatMode"
                                         Margin="0,0,18,0" Checked="RepeatMode_Changed" />
                            <RadioButton x:Name="DurationRadio" Content="연속 실행" GroupName="RepeatMode"
                                         Checked="RepeatMode_Changed" />
                        </WrapPanel>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="반복 횟수" Margin="0,0,0,5" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                <TextBox x:Name="RepeatCountBox" Text="1" Height="36" Padding="9,6" IsEnabled="False" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="연속 실행 시간(초)" Margin="0,0,0,5" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                <TextBox x:Name="DurationSecondsBox" Text="10" Height="36" Padding="9,6" IsEnabled="False" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="동작 간격(밀리초)" Margin="0,12,0,5" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="−" Height="36" Click="DecreaseInterval_Click" />
                            <TextBox Grid.Column="1" x:Name="IntervalBox" Text="100" Height="36"
                                     Margin="8,0" Padding="9,6" TextAlignment="Center" />
                            <Button Grid.Column="2" Content="＋" Height="36" Click="IncreaseInterval_Click" />
                        </Grid>
                        <WrapPanel Margin="0,7,0,0" HorizontalAlignment="Center">
                            <Button Content="50ms" Padding="8,5" Tag="50" Click="IntervalPreset_Click" />
                            <Button Content="100ms" Padding="8,5" Tag="100" Click="IntervalPreset_Click" />
                            <Button Content="250ms" Padding="8,5" Tag="250" Click="IntervalPreset_Click" />
                            <Button Content="500ms" Padding="8,5" Tag="500" Click="IntervalPreset_Click" />
                            <Button Content="1초" Padding="8,5" Tag="1000" Click="IntervalPreset_Click" />
                        </WrapPanel>
                    </StackPanel>

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="취소" Height="42" IsCancel="True" />
                        <Button Grid.Column="2" Content="마우스 동작 적용" Height="42"
                                Style="{StaticResource PrimaryButtonStyle}" Click="Apply_Click" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
