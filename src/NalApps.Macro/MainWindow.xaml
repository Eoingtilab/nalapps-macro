<Window x:Class="NalApps.Macro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="날라앱스 매크로"
        Width="840" Height="520"
        MinWidth="760" MinHeight="470"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="205" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="White"
                CornerRadius="18"
                Padding="14,10"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource PrimaryBrush}" Margin="0,0,9,0">
                        <TextBlock Text="N" Foreground="White" FontWeight="Bold" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="날라앱스 매크로" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="NalaApps Macro" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="새로 만들기" Click="NewMacro_Click" />
                    <Button Content="불러오기" Click="Load_Click" />
                    <Button Content="저장" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="18"
                Padding="8"
                Effect="{StaticResource CardShadow}">
            <WrapPanel VerticalAlignment="Center">
                <Button Content="＋ 위치" Style="{StaticResource PrimaryButtonStyle}" Click="PickPosition_Click" />
                <Button Content="좌클릭" Click="AddLeftClick_Click" />
                <Button Content="우클릭" Click="AddRightClick_Click" />
                <Button Content="더블클릭" Click="AddDoubleClick_Click" />
                <Button Content="휠" Click="AddWheel_Click" />
                <Button Content="문자" Click="AddText_Click" />
                <Button Content="키" Click="AddKey_Click" />
                <Button Content="대기" Click="AddDelay_Click" />
            </WrapPanel>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="245" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="18"
                    Padding="12"
                    Effect="{StaticResource CardShadow}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="2,0,2,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="실행 순서" FontSize="15" FontWeight="Bold" />
                            <TextBlock Text="위에서 아래 순서로 실행됩니다"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="10" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="↑" Width="34" Click="MoveUp_Click" />
                            <Button Content="↓" Width="34" Click="MoveDown_Click" />
                            <Button Content="삭제" Click="DeleteStep_Click" />
                        </StackPanel>
                    </Grid>

                    <ListBox x:Name="StepList"
                             DisplayMemberPath="Summary"
                             SelectionChanged="StepList_SelectionChanged"
                             FontSize="12"
                             MaxHeight="145" />
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="18"
                    Padding="12"
                    Effect="{StaticResource CardShadow}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="선택 단계 편집" FontSize="15" FontWeight="Bold" />
                        <TextBlock x:Name="SelectedTypeText"
                                   Text="선택된 단계 없음"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="10"
                                   Margin="0,3,0,8"
                                   TextWrapping="Wrap" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="X" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                <TextBox x:Name="XBox" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Y" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                <TextBox x:Name="YBox" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="문자 또는 키" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,3" />
                        <TextBox x:Name="TextValueBox" AcceptsReturn="True" MinHeight="40" TextWrapping="Wrap" />

                        <TextBlock Text="값 (ms / 휠)" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,3" />
                        <TextBox x:Name="NumberValueBox" />

                        <Button Content="설정 적용"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,8,0,2"
                                Click="ApplyStep_Click" />
                        <Button Content="위치 테스트" Margin="0,2,0,0" Click="TestPosition_Click" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="6"
                Background="White"
                CornerRadius="18"
                Padding="12,10"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="반복" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    <TextBox x:Name="RepeatCountBox" Text="1" Width="52" Margin="7,0,6,0" />
                    <CheckBox x:Name="InfiniteRepeatCheck" Content="무한" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="이름" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    <TextBox x:Name="MacroNameBox" Text="새 매크로" Width="130" Margin="7,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="14,0" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="준비됨" FontWeight="SemiBold" FontSize="11" />
                    <TextBlock x:Name="ProgressText"
                               Text="Ctrl+Alt+F8 위치 · F9 시작 · F10 일시정지 · F12 중지"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="9"
                               Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="일시정지" Click="Pause_Click" />
                    <Button Content="중지" Style="{StaticResource DangerButtonStyle}" Click="Stop_Click" />
                    <Button Content="실행" Style="{StaticResource PrimaryButtonStyle}" MinWidth="68" Click="Run_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
