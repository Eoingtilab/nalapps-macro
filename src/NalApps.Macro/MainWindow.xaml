<Window x:Class="NalApps.Macro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="날앱스 매크로" Width="1260" Height="800" MinWidth="1040" MinHeight="680"
        Background="{StaticResource BackgroundBrush}" WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="White" CornerRadius="22" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="NalApps Macro" FontSize="25" FontWeight="Bold" />
                    <TextBlock Text="복잡한 설정 없이 찍고, 추가하고, 실행하세요." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="새로 만들기" Click="NewMacro_Click" />
                    <Button Content="불러오기" Click="Load_Click" />
                    <Button Content="저장" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="310" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="22" Padding="18">
                <StackPanel>
                    <TextBlock Text="단계 추가" FontSize="19" FontWeight="Bold" Margin="4,2,4,12" />
                    <Button Content="⌖ 화면에서 위치 찍기" Background="{StaticResource PrimaryBrush}" Foreground="White" Click="PickPosition_Click" />
                    <Button Content="왼쪽 클릭" Click="AddLeftClick_Click" />
                    <Button Content="오른쪽 클릭" Click="AddRightClick_Click" />
                    <Button Content="더블 클릭" Click="AddDoubleClick_Click" />
                    <Button Content="마우스 휠" Click="AddWheel_Click" />
                    <Button Content="문자 입력" Click="AddText_Click" />
                    <Button Content="키 입력" Click="AddKey_Click" />
                    <Button Content="시간 대기" Click="AddDelay_Click" />
                    <Separator Margin="4,14" />
                    <TextBlock Text="고정 단축키" FontWeight="SemiBold" Margin="4,0,4,8" />
                    <TextBlock Text="위치 저장  Ctrl + Alt + F8&#x0a;시작/재개  Ctrl + Alt + F9&#x0a;일시정지  Ctrl + Alt + F10&#x0a;긴급 중지  Ctrl + Alt + F12"
                               Foreground="{StaticResource MutedBrush}" LineHeight="23" Margin="4" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="22" Padding="22">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="실행 순서" FontSize="22" FontWeight="Bold" />
                            <TextBlock Text="선택한 단계는 오른쪽에서 수정할 수 있습니다." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="위로" Click="MoveUp_Click" />
                            <Button Content="아래로" Click="MoveDown_Click" />
                            <Button Content="삭제" Click="DeleteStep_Click" />
                        </StackPanel>
                    </Grid>

                    <ListBox x:Name="StepList" Margin="0,18,0,14" BorderThickness="0" Background="Transparent"
                             DisplayMemberPath="Summary" SelectionChanged="StepList_SelectionChanged" FontSize="15" />

                    <Border DockPanel.Dock="Bottom" Background="#F5F7FA" CornerRadius="17" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="StatusText" Text="준비됨" FontWeight="SemiBold" />
                                <TextBlock x:Name="ProgressText" Text="시작 Ctrl+Alt+F9 · 중지 Ctrl+Alt+F12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="일시정지" Click="Pause_Click" />
                                <Button Content="중지" Click="Stop_Click" />
                                <Button Content="실행" Background="{StaticResource PrimaryBrush}" Foreground="White" Click="Run_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>

            <Border Grid.Column="4" Background="White" CornerRadius="22" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="설정" FontSize="21" FontWeight="Bold" />
                        <TextBlock Text="매크로 이름" Margin="0,18,0,7" FontWeight="SemiBold" />
                        <TextBox x:Name="MacroNameBox" Text="새 매크로" Padding="12" />

                        <TextBlock Text="반복" Margin="0,16,0,7" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="RepeatCountBox" Text="1" Width="90" Padding="12" />
                            <CheckBox x:Name="InfiniteRepeatCheck" Content="무한 반복" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <Separator Margin="0,18" />
                        <TextBlock Text="선택한 단계" FontWeight="SemiBold" />
                        <TextBlock x:Name="SelectedTypeText" Text="선택된 단계 없음" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,12" />

                        <TextBlock Text="X 좌표" />
                        <TextBox x:Name="XBox" Margin="0,5,0,10" Padding="10" />
                        <TextBlock Text="Y 좌표" />
                        <TextBox x:Name="YBox" Margin="0,5,0,10" Padding="10" />
                        <TextBlock Text="문자 또는 키" />
                        <TextBox x:Name="TextValueBox" Margin="0,5,0,10" Padding="10" AcceptsReturn="True" MinHeight="55" />
                        <TextBlock Text="값 (대기 ms / 휠 양)" />
                        <TextBox x:Name="NumberValueBox" Margin="0,5,0,10" Padding="10" />

                        <Button Content="선택 단계 적용" Background="{StaticResource PrimaryBrush}" Foreground="White" Click="ApplyStep_Click" />
                        <Button Content="저장 위치 테스트" Click="TestPosition_Click" />
                        <TextBlock Text="키 입력 예: ENTER, TAB, ESC, SPACE, CTRL+C, CTRL+V, ALT+F4"
                                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="4,10,4,0" LineHeight="20" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
