<Window x:Class="NalApps.Macro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="날앱스 매크로" Width="1180" Height="760" MinWidth="980" MinHeight="640"
        Background="{StaticResource BackgroundBrush}" WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" CornerRadius="24" Padding="20">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="NalApps Macro" FontSize="22" FontWeight="Bold" Margin="4,4,4,18" />
                    <Button Content="+ 새 매크로" Background="{StaticResource PrimaryBrush}" Foreground="White" Click="NewMacro_Click" />
                </StackPanel>
                <ListBox x:Name="MacroList" Margin="0,18,0,0" BorderThickness="0" Background="Transparent" />
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Background="White" CornerRadius="24" Padding="24">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="매크로 편집" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="단계를 순서대로 추가한 뒤 실행하세요." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,16" />
                    <WrapPanel>
                        <Button Content="화면에서 위치 찍기" Background="{StaticResource PrimaryBrush}" Foreground="White" Click="PickPosition_Click" />
                        <Button Content="왼쪽 클릭" Click="AddLeftClick_Click" />
                        <Button Content="문자 입력" Click="AddText_Click" />
                        <Button Content="시간 대기" Click="AddDelay_Click" />
                    </WrapPanel>
                </StackPanel>
                <ListBox x:Name="StepList" Margin="0,18,0,18" BorderThickness="0" Background="Transparent" DisplayMemberPath="Summary" />
                <Border DockPanel.Dock="Bottom" Background="#F7F9FC" CornerRadius="18" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText" Text="준비됨 · 시작 Ctrl+Alt+F9 · 중지 Ctrl+Alt+F12" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="실행" Background="{StaticResource PrimaryBrush}" Foreground="White" Click="Run_Click" />
                            <Button Content="중지" Click="Stop_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </DockPanel>
        </Border>

        <Border Grid.Column="4" Background="White" CornerRadius="24" Padding="22">
            <StackPanel>
                <TextBlock Text="단계 설정" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="마우스 위치" FontWeight="SemiBold" Margin="0,22,0,8" />
                <Border Background="#F2F4F6" CornerRadius="14" Padding="14">
                    <TextBlock x:Name="CoordinateText" Text="아직 지정되지 않음" />
                </Border>
                <Button Content="위치 테스트" Margin="0,10,0,0" Click="TestPosition_Click" />
                <TextBlock Text="위치 지정 방법" FontWeight="SemiBold" Margin="0,24,0,8" />
                <TextBlock Text="버튼을 누른 뒤 원하는 위치로 이동하고 Ctrl + Alt + F8을 누르세요. Esc로 취소할 수 있습니다." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" LineHeight="22" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
