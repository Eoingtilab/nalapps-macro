<Window x:Class="NalApps.Macro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="날라매크로"
        Width="470" Height="520"
        MinWidth="450" MinHeight="480"
        MaxWidth="620" MaxHeight="720"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        Loaded="MainWindow_Loaded"
        SourceInitialized="MainWindow_SourceInitialized"
        Closing="Window_Closing">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource NalaCard}" Padding="12,9">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="9" Background="{StaticResource PrimaryBrush}" Margin="0,0,9,0">
                        <TextBlock Text="N" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="날라매크로" FontSize="15" FontWeight="Bold" />
                        <TextBlock Text="키보드·마우스·문자·시간 동작을 순서대로 실행합니다" FontSize="9.5" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="새로" Padding="9,6" Click="NewMacro_Click" />
                    <Button Content="열기" Padding="9,6" Click="Load_Click" />
                    <Button Content="저장" Padding="9,6" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="116" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource NalaCard}" Padding="10">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="1,0,1,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="실행 순서" FontSize="13" FontWeight="Bold" />
                            <TextBlock Text="위에서 아래로 실행됩니다" FontSize="9" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ToggleButton x:Name="InsertBelowCheck" Content="아래 삽입" Height="28" Padding="8,0" Margin="0,0,5,0" ToolTip="켜면 새 동작을 선택한 단계 바로 아래에 삽입합니다." />
                            <Button Content="↑" Style="{StaticResource IconButtonStyle}" Click="MoveUp_Click" ToolTip="위로 이동" />
                            <Button Content="↓" Style="{StaticResource IconButtonStyle}" Click="MoveDown_Click" ToolTip="아래로 이동" />
                        </StackPanel>
                    </Grid>
                    <ListBox x:Name="StepList" SelectionChanged="StepList_SelectionChanged" FontSize="11.5" Margin="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding RuntimeStatus}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0" VerticalAlignment="Center">
                                        <Button Content="⧉" Tag="{Binding}" ToolTip="이 단계를 바로 아래에 복사"
                                                Width="22" Height="22" Padding="0" Margin="0,0,3,0" FontSize="10"
                                                Style="{StaticResource IconButtonStyle}" Click="CopyInline_Click" />
                                        <Button Content="×" Tag="{Binding}" ToolTip="이 동작 삭제"
                                                Width="20" Height="20" Padding="0" Margin="0"
                                                FontSize="10" Style="{StaticResource DangerButtonStyle}" Click="DeleteInline_Click" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <StackPanel Grid.Column="2" x:Name="ActionPanel">
                <Button Content="⌨  키보드" Height="39" Margin="0,0,0,6" Click="AddKeyboard_Click" />
                <Button Content="⌖  마우스" Height="39" Margin="0,0,0,6" Style="{StaticResource PrimaryButtonStyle}" Click="AddMouse_Click" />
                <Button Content="◷  시간" Height="39" Margin="0,0,0,6" Click="AddDelay_Click" />
                <Button Content="A  문자" Height="39" Margin="0,0,0,6" Click="AddText_Click" />
                <Button x:Name="ActionMenuButton" Content="＋  동작" Height="39" Margin="0,0,0,6" Click="OpenActionMenu_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="마우스 이동" Tag="move" Click="AddMousePreset_Click" /><Separator />
                            <MenuItem Header="왼쪽 클릭" Tag="left" Click="AddMousePreset_Click" />
                            <MenuItem Header="오른쪽 클릭" Tag="right" Click="AddMousePreset_Click" />
                            <MenuItem Header="더블 클릭" Tag="double" Click="AddMousePreset_Click" />
                            <MenuItem Header="연속 왼쪽 클릭" Tag="continuous-left" Click="AddMousePreset_Click" />
                            <MenuItem Header="연속 오른쪽 클릭" Tag="continuous-right" Click="AddMousePreset_Click" /><Separator />
                            <MenuItem Header="휠 위" Tag="wheel-up" Click="AddMousePreset_Click" />
                            <MenuItem Header="휠 아래" Tag="wheel-down" Click="AddMousePreset_Click" /><Separator />
                            <MenuItem Header="키 누르고 있기" Tag="key-hold" Click="AddQuickAction_Click" />
                            <MenuItem Header="문자 입력" Tag="text" Click="AddQuickAction_Click" />
                            <MenuItem Header="대기 시간" Tag="delay" Click="AddQuickAction_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Content="편집" Height="36" Click="EditSelectedStep_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource NalaCard}" Padding="10,8">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="InfiniteRepeatCheck" Content="무한 반복" Margin="0,0,8,0" />
                        <TextBlock Text="횟수" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        <TextBox x:Name="RepeatCountBox" Text="1" Width="44" Height="29" Margin="5,0,0,0" Padding="6,3" />
                    </StackPanel>
                    <TextBox Grid.Column="1" x:Name="MacroNameBox" Text="새 매크로" Height="29" Margin="10,0" Padding="7,3" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="▶ 시작" Height="32" MinWidth="72" Padding="10,4" Style="{StaticResource PrimaryButtonStyle}" Click="Run_Click" />
                        <Button Content="일시정지" Height="32" Padding="9,4" Click="Pause_Click" />
                        <Button Content="중지" Height="32" Padding="9,4" Style="{StaticResource DangerButtonStyle}" Click="Stop_Click" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,7,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="StatusText" Text="준비됨" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock x:Name="ProgressText" Text="Ctrl+Alt+F8 위치 · Ctrl+Alt+F9 시작 · Ctrl+Alt+F10 일시정지 · Ctrl+Alt+F12 중지" FontSize="8.5" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="NALLA Apps" FontSize="8.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" />
                </Grid>
            </StackPanel>
        </Border>

        <Grid Visibility="Collapsed">
            <TextBlock x:Name="SelectedTypeText" />
            <TextBox x:Name="XBox" />
            <TextBox x:Name="YBox" />
            <TextBox x:Name="TextValueBox" />
            <TextBox x:Name="NumberValueBox" />
            <TextBox x:Name="SecondsValueEditorBox" />
        </Grid>
    </Grid>
</Window>
