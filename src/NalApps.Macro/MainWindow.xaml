<Window x:Class="NalApps.Macro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="날라앱스 매크로"
        Width="470" Height="410"
        MinWidth="430" MinHeight="370"
        MaxWidth="620" MaxHeight="620"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <Menu DockPanel.Dock="Left" Background="Transparent" BorderThickness="0" Padding="4,2">
                    <MenuItem Header="파일">
                        <MenuItem Header="새로 만들기" Click="NewMacro_Click" />
                        <MenuItem Header="불러오기" Click="Load_Click" />
                        <MenuItem Header="저장" Click="Save_Click" />
                    </MenuItem>
                    <MenuItem Header="시작">
                        <MenuItem Header="실행" Click="Run_Click" />
                        <MenuItem Header="일시정지" Click="Pause_Click" />
                        <MenuItem Header="중지" Click="Stop_Click" />
                    </MenuItem>
                    <MenuItem Header="설정">
                        <MenuItem Header="위치 지정" Click="PickPosition_Click" />
                        <MenuItem Header="위치 테스트" Click="TestPosition_Click" />
                    </MenuItem>
                    <MenuItem Header="동작 추가">
                        <MenuItem Header="좌클릭" Click="AddLeftClick_Click" />
                        <MenuItem Header="우클릭" Click="AddRightClick_Click" />
                        <MenuItem Header="더블클릭" Click="AddDoubleClick_Click" />
                        <MenuItem Header="휠" Click="AddWheel_Click" />
                        <MenuItem Header="문자 입력" Click="AddText_Click" />
                    </MenuItem>
                </Menu>
                <TextBlock Text="NalaApps" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" FontSize="10" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="10,9,10,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="9" />
                <ColumnDefinition Width="112" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#F8F9FB" CornerRadius="12,12,0,0" Padding="10,7"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="실행 순서" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="위에서 아래로 실행" FontSize="9" Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="↑" Width="29" Height="27" Padding="0" Click="MoveUp_Click" />
                                <Button Content="↓" Width="29" Height="27" Padding="0" Click="MoveDown_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ListBox x:Name="StepList"
                             DisplayMemberPath="Summary"
                             SelectionChanged="StepList_SelectionChanged"
                             FontSize="12"
                             Margin="5" />
                </DockPanel>
            </Border>

            <StackPanel Grid.Column="2">
                <Button Content="키보드" Height="42" Margin="0,0,0,6" Click="AddKey_Click" />
                <Button Content="마우스" Height="42" Margin="0,0,0,6" Style="{StaticResource PrimaryButtonStyle}" Click="PickPosition_Click" />
                <Button Content="시간" Height="42" Margin="0,0,0,6" Click="AddDelay_Click" />
                <Button Content="문자" Height="42" Margin="0,0,0,6" Click="AddText_Click" />
                <Button Content="지우기" Height="42" Margin="0,0,0,8" Click="DeleteStep_Click" />
                <Button Content="실행" Height="42" Style="{StaticResource PrimaryButtonStyle}" Click="Run_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Margin="10,0,10,10" Background="White" CornerRadius="12"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="10,8">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <RadioButton Grid.Column="0" Content="추가" IsChecked="True" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <RadioButton Grid.Column="1" Content="삽입" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="2" x:Name="InfiniteRepeatCheck" Content="반복" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="횟수" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        <TextBox x:Name="RepeatCountBox" Text="1" Width="42" Height="28" Margin="5,0,8,0" Padding="6,3" />
                        <TextBox x:Name="MacroNameBox" Text="새 매크로" Width="90" Height="28" Padding="6,3" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button Content="일시정지" Height="28" Padding="8,3" Click="Pause_Click" />
                        <Button Content="중지" Height="28" Padding="8,3" Style="{StaticResource DangerButtonStyle}" Click="Stop_Click" />
                    </StackPanel>
                </Grid>

                <Expander Header="선택 단계 상세 설정" Margin="0,7,0,0">
                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" x:Name="SelectedTypeText" Text="선택된 단계 없음"
                                   Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,5" />
                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Text="X / 문자·키" FontSize="9" Foreground="{StaticResource MutedBrush}" />
                            <TextBox x:Name="XBox" Height="27" Padding="5,2" />
                            <TextBox x:Name="TextValueBox" Height="27" Padding="5,2" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Text="Y / 값(ms·휠)" FontSize="9" Foreground="{StaticResource MutedBrush}" />
                            <TextBox x:Name="YBox" Height="27" Padding="5,2" />
                            <TextBox x:Name="NumberValueBox" Height="27" Padding="5,2" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                            <Button Content="위치 테스트" Height="28" Padding="9,3" Click="TestPosition_Click" />
                            <Button Content="설정 적용" Height="28" Padding="9,3" Style="{StaticResource PrimaryButtonStyle}" Click="ApplyStep_Click" />
                        </StackPanel>
                    </Grid>
                </Expander>

                <StackPanel Margin="0,6,0,0">
                    <TextBlock x:Name="StatusText" Text="준비됨" FontWeight="SemiBold" FontSize="10" />
                    <TextBlock x:Name="ProgressText" Text="Ctrl+Alt+F8 위치 · F9 시작 · F10 일시정지 · F12 중지"
                               Foreground="{StaticResource MutedBrush}" FontSize="9" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
