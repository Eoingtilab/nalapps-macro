<Window x:Class="NalApps.Macro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="날라앱스 매크로" Width="880" Height="610" MinWidth="760" MinHeight="520"
        Background="{StaticResource BackgroundBrush}" WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="White" CornerRadius="16" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="11" Background="{StaticResource PrimaryBrush}" Margin="0,0,10,0">
                        <TextBlock Text="N" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="NalaApps Macro" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="찍고 · 추가하고 · 실행" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="새로 만들기" Click="NewMacro_Click" />
                    <Button Content="불러오기" Click="Load_Click" />
                    <Button Content="저장" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="16" Padding="10">
            <WrapPanel VerticalAlignment="Center">
                <Button Content="＋ 위치" Background="{StaticResource PrimaryBrush}" Foreground="White" Click="PickPosition_Click" />
                <Button Content="좌클릭" Click="AddLeftClick_Click" />
                <Button Content="우클릭" Click="AddRightClick_Click" />
                <Button Content="더블클릭" Click="AddDoubleClick_Click" />
                <Button Content="휠" Click="AddWheel_Click" />
                <Button Content="문자" Click="AddText_Click" />
                <Button Content="키" Click="AddKey_Click" />
                <Button Content="대기" Click="AddDelay_Click" />
            </WrapPanel>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="252" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="16" Padding="14">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="2,0,2,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="실행 순서" FontSize="16" FontWeight="Bold" />
                            <TextBlock Text="위에서 아래 순서로 실행됩니다" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="↑" Width="38" Click="MoveUp_Click" />
                            <Button Content="↓" Width="38" Click="MoveDown_Click" />
                            <Button Content="삭제" Click="DeleteStep_Click" />
                        </StackPanel>
                    </Grid>
                    <ListBox x:Name="StepList" DisplayMemberPath="Summary" SelectionChanged="StepList_SelectionChanged" FontSize="13" />
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="16" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="매크로 설정" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="이름" Margin="0,12,0,5" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                        <TextBox x:Name="MacroNameBox" Text="새 매크로" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="반복 횟수" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5" />
                                <TextBox x:Name="RepeatCountBox" Text="1" />
                            </StackPanel>
                            <CheckBox Grid.Column="2" x:Name="InfiniteRepeatCheck" Content="무한" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,14" />
                        <TextBlock Text="선택 단계" FontSize="14" FontWeight="Bold" />
                        <TextBlock x:Name="SelectedTypeText" Text="선택된 단계 없음" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,10" TextWrapping="Wrap" />

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="X" FontSize="11" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="XBox" Margin="0,4,0,0" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Y" FontSize="11" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="YBox" Margin="0,4,0,0" /></StackPanel>
                        </Grid>
                        <TextBlock Text="문자 또는 키" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,4" />
                        <TextBox x:Name="TextValueBox" AcceptsReturn="True" MinHeight="48" TextWrapping="Wrap" />
                        <TextBlock Text="값 (ms / 휠)" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,4" />
                        <TextBox x:Name="NumberValueBox" />

                        <Button Content="설정 적용" Background="{StaticResource PrimaryBrush}" Foreground="White" Margin="0,11,0,3" Click="ApplyStep_Click" />
                        <Button Content="위치 테스트" Margin="0,3,0,0" Click="TestPosition_Click" />
                        <TextBlock Text="키 예시  ENTER · TAB · CTRL+C · ALT+F4" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="2,9,2,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="6" Background="White" CornerRadius="16" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="준비됨" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock x:Name="ProgressText" Text="F8 위치 · F9 시작 · F10 일시정지 · F12 중지 (Ctrl+Alt)" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="일시정지" Click="Pause_Click" />
                    <Button Content="중지" Click="Stop_Click" />
                    <Button Content="실행" Background="{StaticResource PrimaryBrush}" Foreground="White" MinWidth="72" Click="Run_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
